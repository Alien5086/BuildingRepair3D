<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>建築設備維護系統 - V18.5</title>
  <link rel="stylesheet" href="style.css?v=STABLE_FINAL">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dat-gui/0.7.7/dat.gui.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/DRACOLoader.js"></script>
  <!-- 🌟 後期處理特效套件 -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/OutlinePass.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
</head>
<body>
  <div id="app">
    <div id="scene-container"></div>
    
    <div id="ui-overlay">
      <header class="app-header">
        <div class="logo-group">
          <span class="icon">🏛️</span>
          <h1>建築導覽 <span style="font-size:0.7rem; background:rgba(255,255,255,0.2); padding:2px 8px; border-radius:10px; margin-left:10px;">V18.5 (HD Labels & Clean)</span></h1>
        </div>
        <button class="toggle-btn" onclick="toggleView()">
          <span class="btn-icon">📐</span> 切換平面圖
        </button>
      </header>

      <div id="page-2d" class="page">
        <div class="map-container">
          <div class="floor-nav-2d">
            <button id="tab-2d-B1" class="floor-tab" onclick="switch2DFloor('B1')">B1 配置圖</button>
            <button id="tab-2d-1" class="floor-tab active" onclick="switch2DFloor(1)">1F 配置圖</button>
            <button id="tab-2d-2" class="floor-tab" onclick="switch2DFloor(2)">2F 配置圖</button>
            <button id="tab-2d-3" class="floor-tab" onclick="switch2DFloor(3)">3F 配置圖</button>
          </div>
          <div class="image-wrapper-2d">
            <img id="img-2d-B1" src="assets/floor_plan_ref07.png" class="plan-img-2d" alt="B1">
            <img id="img-2d-1" src="assets/skyone01.png" class="plan-img-2d active" alt="1F">
            <img id="img-2d-2" src="assets/skyone02.png" class="plan-img-2d" alt="2F">
            <img id="img-2d-3" src="assets/floor_plan_ref10.png" class="plan-img-2d" alt="3F">
            <div id="plan-markers-2d" class="marker-layer"></div>
          </div>
        </div>
      </div>

      <!-- 底部提示欄 -->
      <div class="bottom-hint">
        <span class="mouse-icon">🖱️</span> 拖曳旋轉 · 滾輪縮放 · 點擊建築物進入維修模式
      </div>
    </div>

    <!-- 🌟 地下室全螢幕 2D 覆蓋層 -->
    <div id="basement-full-2d">
      <div class="full-img-container" onclick="event.stopPropagation()">
        <img src="assets/floor_plan_ref07.png" alt="B1 Full Plan">
        <div id="basement-markers" class="marker-layer"></div>
        <div class="close-tip" onclick="closeBasementFull()">點擊標記或點此關閉</div>
      </div>
    </div>

    <div id="building-label"></div>
    <!-- 🌟 讀取進度條 -->
    <div id="loading-overlay">
      <div class="loader-box">
        <div class="loader-text">系統加載中... <span id="progress-text">0%</span></div>
        <div class="loader-bar"><div id="progress-fill"></div></div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/tween.js/18.6.4/tween.umd.js"></script>
  <script src="app.js?v=999"></script>
  <script src="scene3d.js?v=18.5"></script>
</body>
</html>
